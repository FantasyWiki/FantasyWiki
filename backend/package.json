{
  "name": "backend",
  "type": "module",
  "engines": {
    "node": "24.18.1",
    "npm": "11.19.1"
  },
  "scripts": {
    "dev": "wrangler dev --env local",
    "devgenie": "wrangler dev --env local-genie",
    "devmongo": "wrangler dev --config wrangler.mongo.jsonc",
    "deploy": "npm run deploy:production",
    "deploy:production": "wrangler deploy --minify",
    "deploy:preview": "wrangler deploy --env preview --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "db:init:local": "wrangler d1 migrations apply db --local --env local",
    "db:migrate:remote": "wrangler d1 migrations apply db --remote",
    "db:seed:demo": "wrangler d1 execute db --local --env local --file=./seeds/demo.sql",
    "format": "prettier --check .",
    "formatfix": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint . --max-warnings 0",
    "lintfix": "eslint --fix .",
    "test:integration": "vitest run --config vitest.config.ts",
    "testmongo": "vitest run --config vitest.mongo.config.ts"
  },
  "dependencies": {
    "@hono/oauth-providers": "^0.9.0",
    "@js-temporal/polyfill": "^0.5.1",
    "axios": "^1.16.0",
    "hono": "^4.12.8",
    "mongodb": "^7.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^4.20260423.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@vitest/coverage-istanbul": "^4.1.6",
    "better-sqlite3": "^12.9.0",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "mongodb-memory-server-core": "^11.2.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.5",
    "wrangler": "^4.4.0",
    "yaml": "^2.9.0"
  }
}
