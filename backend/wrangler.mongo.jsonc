{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The MongoDB target, run locally with `npm run devmongo`.
  //
  // A file of its own rather than an environment in wrangler.jsonc, because it
  // is not a deployment: no Cloudflare environment runs on MongoDB, and the
  // file that deploys should not carry a configuration that can never be
  // deployed. Two things here cannot be expressed as an environment anyway —
  // wrangler's `alias` is top-level only, so the D1 config's alias could not be
  // switched off per environment, and this needs the driver it aliases away.
  //
  // It carries what a local session actually uses, and no more — this is not a
  // deployment, so it does not mirror `env.local` binding for binding. See the
  // notes on each omission below.
  "name": "backend-mongo",
  "main": "src/indexPassword.ts",
  "compatibility_date": "2026-03-17",
  // The MongoDB driver reaches for `net`, `tls` and `crypto`. Needed here and
  // nowhere else — see docs/architecture/persistence-targets.md.
  "compatibility_flags": ["nodejs_compat"],
  // No `d1_databases`: this run has no D1 to bind. `composition.ts` reads
  // PERSISTENCE below and never looks for one.
  //
  // No `workflows` and no `triggers` either. The settlement Workflow is only
  // ever started by the daily cron, which does not fire in a local session, so
  // binding it here would be deployment machinery this run never touches.
  //
  // The rate limiters below are *not* here to limit anything:
  // `routes/leagues.ts`, `routes/me.ts` and `routes/reports.ts` call
  // `c.env.*_RATE_LIMITER.limit(...)` unconditionally, so without the bindings
  // joining by invitation code, the Article Genie and the problem-report form
  // would each fail with a TypeError rather than run unlimited.
  "unsafe": {
    "bindings": [
      {
        "name": "REPORT_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 3, "period": 60 },
      },
      {
        "name": "GENIE_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 20, "period": 60 },
      },
      {
        "name": "JOIN_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1003",
        "simple": { "limit": 5, "period": 60 },
      },
    ],
  },
  // Workers AI, so the Article Genie is the real thing here — the same model
  // ADR 0006 measured, there being no local one to measure against.
  //
  // `remote` says out loud what is true of every AI binding and cannot be
  // otherwise: there is no local simulator, so a call leaves the machine and
  // spends the account's neuron allocation even in dev. Stating it also settles
  // the warning wrangler prints when it is left implicit.
  //
  // The server still starts without Cloudflare credentials — only a Genie
  // *call* needs them, and it fails as `GENIE_ERRORS.ASLEEP` rather than
  // stopping the run.
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "vars": {
    // What makes this the MongoDB run. `MONGO_URL` names a **replica set** —
    // the guarded writes are transactions, and a standalone `mongod` has none.
    // docs/development/local-dev-setup.md has the one-line docker command.
    "PERSISTENCE": "mongo",
    "MONGO_URL": "mongodb://127.0.0.1:27017/fantasywiki?directConnection=true",
    "GOOGLE_CLIENT_ID": "457796621894-7krpa8n09mekpj2cdd952jjkf1c3ookt.apps.googleusercontent.com",
    "GITHUB_REPO": "FantasyWiki/FantasyWiki",
    "ENVIRONMENT": "local",
    "GH_APP_ID": "4298123",
    "GH_APP_INSTALLATION_ID": "146572827",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
