# Copy to `frontend/.env.local`. That file is gitignored; this one is the
# checked-in shape of it. See docs/development/local-dev-setup.md.

# Include the scheme explicitly — the value is used as-is at runtime.
VITE_BACKEND_URL=http://127.0.0.1:8787

# MSW intercepts every /api/* call except /api/session and /auth/*, which reach
# the real local backend. Set to false to run against the backend for real.
VITE_MOCK=true

# Uncomment to get a "Continue as demo player" button on the login screen, and
# skip GOOGLE_CLIENT_SECRET entirely. It only ever appears in a build started
# with this set, and the backend answers /auth/dev with a 404 unless it is
# running as `--env local` — the containers set it, which is why `docker compose
# up` needs no credentials at all.
# VITE_DEV_LOGIN=true
